{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chinmay28/bulls-and-bears/specs/strategy.schema.json",
  "title": "Strategy spec",
  "description": "A strategy the runtime may trade: what to run, with what parameters, sized how, and the backtest that earned it the right. Emitted by research, consumed by the Go runtime. The runtime refuses any spec missing provenance, with oos_sharpe under 1.0, or older than ttl_days.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "strategy", "universe", "params", "sizing", "provenance"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "version": { "type": "integer", "minimum": 1 },
    "strategy": {
      "description": "Must match a registered Go and Python implementation.",
      "type": "string",
      "enum": ["pairs_zscore"]
    },
    "universe": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9.]{0,9}$" }
    },
    "params": {
      "type": "object",
      "description": "Strategy-specific. pairs_zscore takes hedge_ratio, lookback, entry_z, exit_z, max_hold_days.",
      "additionalProperties": { "type": "number" }
    },
    "sizing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gross_leverage", "max_notional_per_leg_usd"],
      "properties": {
        "gross_leverage": { "type": "number", "exclusiveMinimum": 0, "maximum": 2 },
        "max_notional_per_leg_usd": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train_window", "test_window", "oos_sharpe", "oos_max_drawdown", "cost_model", "research_git_sha", "generated_at", "ttl_days"],
      "properties": {
        "train_window": { "$ref": "#/$defs/window" },
        "test_window": { "$ref": "#/$defs/window" },
        "oos_sharpe": { "type": "number" },
        "oos_max_drawdown": { "type": "number", "maximum": 0 },
        "cost_model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commission_usd", "slippage_bps"],
          "properties": {
            "commission_usd": { "type": "number", "minimum": 0 },
            "slippage_bps": { "type": "number", "minimum": 0 }
          }
        },
        "research_git_sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "generated_at": { "type": "string", "format": "date-time" },
        "ttl_days": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "format": "date" },
        "to": { "type": "string", "format": "date" }
      }
    }
  }
}
